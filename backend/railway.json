{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["src/**", "pom.xml", "railway.json"]
  },
  "deploy": {
    "startCommand": "java -jar target/campus-service-tracker-0.0.1-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
